{
  "name": "petems-cockpit",
  "version": "1.0.1",
  "author": "Peter Souter",
  "summary": "Module for installing and managing Cockpit (http://cockpit-project.org/)",
  "license": "Apache-2.0",
  "source": "git://github.com/petems/petems-cockpit",
  "project_page": "https://github.com/petems/petems-cockpit",
  "issues_url": "https://github.com/petems/petems-cockpit/issues",
  "tags": [
    "cockpit"
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "Debian",
      "operatingsystemrelease": [
        "11",
        "12"
      ]
    },
    {
      "operatingsystem": "OpenBSD"
    },
    {
      "operatingsystem": "RedHat",
      "operatingsystemrelease": [
        "8",
        "9"
      ]
    },
    {
      "operatingsystem": "Rocky",
      "operatingsystemrelease": [
        "8",
        "9"
      ]
    },
    {
      "operatingsystem": "AlmaLinux",
      "operatingsystemrelease": [
        "8",
        "9"
      ]
    },
    {
      "operatingsystem": "OracleLinux",
      "operatingsystemrelease": [
        "8",
        "9"
      ]
    },
    {
      "operatingsystem": "CentOS",
      "operatingsystemrelease": [
        "9"
      ]
    },
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": [
        "20.04",
        "22.04"
      ]
    }
  ],
  "requirements": [
    {
      "name": "puppet",
      "version_requirement": ">= 8.0.0 < 9.0.0"
    }
  ],
  "dependencies": [
    {
      "name": "puppetlabs-stdlib",
      "version_requirement": ">= 9.7.0"
    },
    {
      "name": "puppetlabs-apt",
      "version_requirement": ">=6.2.0"
    },
    {
      "name": "puppetlabs-inifile",
      "version_requirement": ">= 1.5.0 <2.0.0"
    }
  ]
}
